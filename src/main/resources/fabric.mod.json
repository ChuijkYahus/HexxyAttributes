	"authors": [
		"Just_S"
	],
	"contact": {
		"sources": "https://github.com/JustS-js/HexxyOrigins"
	},
	"license": "CC0-1.0",
	"icon": "assets/hexxyorigins/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "net.just_s.HexxyOriginsMod"
		],
		"client": [
          "net.just_s.HexxyOriginsModClient"
		]
	},
	"mixins": [
